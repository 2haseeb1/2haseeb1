{
  "expo": {
    "name": "Blink",
    "slug": "blink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blink",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0D14",
    "primaryColor": "#7C8CFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blink.todo",
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.blink.todo",
      "adaptiveIcon": {
        "backgroundColor": "#0A0D14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0D14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#0A0D14"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.blink.todo",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "BlinkNow",
              "displayName": "Blink",
              "description": "The one thing, right on your home screen.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryCircular",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": false,
              "android": null
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BlinkNow",
              "label": "Blink",
              "description": "The one thing, right on your home screen.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "BlinkShare",
          "iosAppGroupIdentifier": "group.com.blink.todo",
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
